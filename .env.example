# ── rungs 配置模板 ──────────────────────────────────────────────────
# 复制为 .env 后填写真实值：  cp .env.example .env
#
# 变量名由 crates/config 的 AppConfig 字段决定（envy 自动转大写），不可改名。
# 常见坑：是 BINANCE_APIKEY 而非 BINANCE_API_KEY，是 JWT_SECRET 而非 JWT_SECRET_KEY。

# ── Binance API 凭据 ──────────────────────────────────────────────────────────
# 现货交易权限即可，不要开提现权限。密钥形如 64 位字母数字。
BINANCE_APIKEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_api_secret_here

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# sqlx 只认 postgres:// 或 postgresql://，不支持 +asyncpg 之类的驱动后缀。
# 建库：createdb rungs
# 建表：for f in migrations/*.sql; do psql "$DATABASE_URL" -f "$f"; done
#       （必须按文件名顺序执行全部迁移，且要先于 cargo build —— sqlx::query! 在编译期连库校验 SQL）
DATABASE_URL=postgres://postgres:password@localhost:5432/rungs

# ── JWT ───────────────────────────────────────────────────────────────────────
# 最短 32 字符，app 启动时强制校验。生成：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_at_least_32_random_characters

# ── 可选 ──────────────────────────────────────────────────────────────────────
# Web API 监听端口，默认 3000（frontend/vite.config.ts 的代理指向此端口）
PORT=3000
# 监听地址，默认 127.0.0.1。
# 该 API 持有交易所下单/撤单权限且共用单套密钥，绝不要直接暴露到公网；
# 需要远程访问请走 nginx + TLS + 访问控制。设为 0.0.0.0 时启动日志会打印告警。
BIND_ADDR=127.0.0.1
# 日志级别，默认 info
RUST_LOG=info
